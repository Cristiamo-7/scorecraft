  "sections": [
    {
      "label": "第一句",
      "startBeat": 0,
      "endBeat": 16,
      "text": "去年我回去，你们刚穿新棉袍"
    },
    {
      "label": "第二句",
      "startBeat": 16,
      "endBeat": 32,
      "text": "今年我来看你们，你们变胖又变高"
    },
    {
      "label": "第三句",
      "startBeat": 32,
      "endBeat": 48,
      "text": "你们可记得，池里荷花变莲蓬"
    },
    {
      "label": "第四句",
      "startBeat": 48,
      "endBeat": 64,
      "text": "花少不愁没颜色，我把树叶都染红"
    }
  ]
